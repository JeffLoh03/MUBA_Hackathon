GONKA_BASE_URL=https://api.gonkarouter.io/v1
# Required. Keep the real key only in .env, never in this example file.
GONKA_API_KEY=
GONKA_TIMEOUT_SECONDS=60

GONKA_CLAIM_MODEL=MiniMaxAI/MiniMax-M2.7
GONKA_VERIFY_MODEL_1=deepseek-ai/DeepSeek-V4-Flash-0731
GONKA_VERIFY_MODEL_2=MiniMaxAI/MiniMax-M2.7
GONKA_JUDGE_MODEL=MiniMaxAI/MiniMax-M2.7
# Dedicated final decision reviewer. Runs after two independent verifier outputs.
GONKA_DECISION_MODEL=moonshotai/Kimi-K2.6
# Optional third model. Confirm inference works with your account before setting.
GONKA_FALLBACK_MODEL=
# Optional. Leave blank to use OCR and the supplied caption for images.
GONKA_VISION_MODEL=

# DuckDuckGo requires no key. TAVILY_API_KEY is required only when this is tavily.
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# SQLite audit history. Relative paths are resolved from the project root.
VERITY_DB_PATH=data/verity_desk.db

# Optional Tesseract executable path if automatic detection cannot find it.
TESSERACT_CMD=

# Set true behind HTTPS in a public deployment; false permits local HTTP login.
VERITY_COOKIE_SECURE=false
